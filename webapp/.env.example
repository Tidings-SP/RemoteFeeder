# Firebase web configuration. Copy this file to .env.local and add the values
# from Firebase Console. In Vercel, add the same variables in Project Settings
# > Environment Variables instead of committing a .env file.
#
# These NEXT_PUBLIC_ values identify the Firebase web app and will be visible
# in the browser bundle. Do not place passwords, service-account JSON, database
# secrets, or Wi-Fi credentials in this file or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
